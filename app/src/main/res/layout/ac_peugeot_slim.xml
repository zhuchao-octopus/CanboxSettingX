<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@mipmap/slim_ac_bg"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0px"
        android:layout_marginStart="1.0dip"
        android:layout_marginTop="1.0dip"
        android:layout_marginEnd="1.0dip"
        android:layout_weight="2"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="60dp"
            android:layout_marginRight="30dp"
            android:src="@mipmap/slim_ac_temperature" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/con_left_temp_up"
                android:paddingTop="30dp"
                style="@style/AirButtonStyle3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:src="@mipmap/slim_up_icon" />

            <com.canboxsetting.view.ACTempLevelSelect
                android:id="@+id/ac_temp_level"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/con_left_temp_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="30dp"
                style="@style/AirButtonStyle3"
                android:background="#00000000"
                android:src="@mipmap/slim_down_icon" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="4.0"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/close_ac"
                style="@style/AirButtonStyle3"
                android:layout_width="wrap_content"
                android:layout_centerHorizontal="true"
                android:padding="20dp"
                android:src="@drawable/slim_ac_close_bt" />

            <RelativeLayout
                android:layout_alignRight="@+id/person_icon"
                android:layout_centerVertical="true"
                android:paddingTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="260dp">
                <ImageView
                    android:id="@+id/ac_speed_up"
                    android:paddingLeft="40dp"
                    android:src="@mipmap/slim_speed_up_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/ac_speed_middle"
                    android:src="@mipmap/slim_speed_middle_on"
                    android:layout_centerVertical="true"
                    android:paddingTop="5dp"
                    android:paddingLeft="50dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/ac_speed_down"
                    android:src="@mipmap/slim_speed_down_on"
                    android:layout_alignParentBottom="true"
                    android:paddingLeft="40dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>

            <ImageView
                android:id="@+id/person_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:paddingTop="50dp"
                android:layout_marginRight="250dp"
                android:src="@mipmap/slim_person_icon" />

            <ImageView
                android:id="@+id/canbus21_mode1"
                style="@style/AirButtonStyle3"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="100dp"
                android:src="@drawable/slim_ac_model_4" />

            <ImageView
                android:id="@+id/canbus21_mode2"
                style="@style/AirButtonStyle3"
                android:paddingBottom="50dp"
                android:paddingLeft="100dp"
                android:layout_alignParentBottom="true"
                android:src="@drawable/slim_ac_model_2" />

            <ImageView
                android:id="@+id/canbus21_mode3"
                style="@style/AirButtonStyle3"
                android:paddingTop="50dp"
                android:paddingRight="100dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/slim_ac_model_3" />

            <ImageView
                android:id="@+id/canbus21_mode4"
                style="@style/AirButtonStyle3"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="50dp"
                android:layout_marginRight="100dp"
                android:src="@drawable/slim_ac_model_1"
                android:visibility="visible" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="1.0dip"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wind_add"
                style="@style/AirButtonStyle3"
                android:paddingTop="30dp"
                android:src="@mipmap/slim_up_icon" />
            <com.canboxsetting.view.ACSpeedLevelSelect
                android:id="@+id/ac_speed_level"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/wind_minus"
                style="@style/AirButtonStyle3"
                android:paddingBottom="30dp"
                android:src="@mipmap/slim_down_icon" />
        </LinearLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="60dp"
            android:src="@mipmap/slim_ac_speed" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.0dip"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon_power"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_ac_power_bt" />
        <ImageView
            android:src="@mipmap/slim_dividing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/air_title_ce_ac_1"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_ac_bt" />
        <ImageView
            android:src="@mipmap/slim_dividing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/air_title_ce_ac_max"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_ac_max_bt" />
        <ImageView
            android:src="@mipmap/slim_dividing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/air_title_ce_inner_loop"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_air_title_ce_inner_loop" />
        <ImageView
            android:src="@mipmap/slim_dividing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/air_title_ce_max"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_ac_defogging_after_bt" />
        <ImageView
            android:src="@mipmap/slim_dividing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/air_title_ce_rear"
            style="@style/AirButtonStyle3"
            android:layout_weight="1"
            android:src="@drawable/slim_ac_defogging_bt" />


    </LinearLayout>

</LinearLayout>
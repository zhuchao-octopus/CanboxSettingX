<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/slim_ac_bg"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/close_ac"
        style="@style/AirButtonStyle3"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:padding="20dp"
        android:onClick="onClick"
        android:src="@drawable/slim_ac_close_bt" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginLeft="40dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/slim_setting_vehicle"
                android:background="@drawable/slim_setting_bt_bg"
                android:drawableLeft="@mipmap/slim_setting_vehicle_icon"
                android:text="Vehicle"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:onClick="onClick"
                android:drawablePadding="20dp"
                android:paddingLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/slim_setting_connection"
                android:background="@drawable/slim_setting_bt_bg"
                android:drawableLeft="@mipmap/slim_setting_connection_icon"
                android:text="Connection"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:onClick="onClick"
                android:drawablePadding="20dp"
                android:paddingLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/slim_setting_display"
                android:background="@drawable/slim_setting_bt_bg"
                android:drawableLeft="@mipmap/slim_setting_display_icon"
                android:text="Display"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:onClick="onClick"
                android:drawablePadding="20dp"
                android:paddingLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/slim_setting_sound"
                android:background="@drawable/slim_setting_bt_bg"
                android:drawableLeft="@mipmap/slim_setting_sound_icon"
                android:text="Sound"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:onClick="onClick"
                android:drawablePadding="20dp"
                android:paddingLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/slim_setting_system"
                android:background="@drawable/slim_setting_bt_bg"
                android:drawableLeft="@mipmap/slim_setting_system_icon"
                android:text="System"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:onClick="onClick"
                android:drawablePadding="20dp"
                android:paddingLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/show_slim_setting"
            android:background="@mipmap/slim_vehicle_frame"
            android:layout_marginBottom="30dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="50dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.canboxsetting.view.SlimBottomShortcut
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
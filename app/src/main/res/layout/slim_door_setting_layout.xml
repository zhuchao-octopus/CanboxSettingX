<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/show_setting_icon"
            android:layout_marginLeft="40dp"
            android:padding="10dp"
            android:src="@drawable/slim_back_page"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/show_setting_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_toRightOf="@+id/show_setting_icon"
            android:layout_marginLeft="32dp"
            android:layout_centerVertical="true"
            android:text="@string/smart_car_door_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:src="@mipmap/slim_vehicle_setting_line"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/show_door_setting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>